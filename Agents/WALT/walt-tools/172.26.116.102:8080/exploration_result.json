{
    "tools": [
        {
            "name": "search_projects",
            "start_url": "http://172.26.116.102:8080/dashboard/projects",
            "description": "Search projects by user-provided search terms with optional filters for project type and sorting",
            "elements": [
                {
                    "type": "input",
                    "purpose": "enter user-provided search terms"
                },
                {
                    "type": "select",
                    "purpose": "filter by project type",
                    "options": [
                        "All",
                        "Personal",
                        "Internal",
                        "Public"
                    ]
                },
                {
                    "type": "select",
                    "purpose": "sort results",
                    "options": [
                        "Last updated",
                        "Name",
                        "Created date",
                        "Stars"
                    ]
                },
                {
                    "type": "button",
                    "purpose": "submit search"
                }
            ]
        },
        {
            "name": "create_project",
            "start_url": "http://172.26.116.102:8080/projects/new",
            "description": "Create a new project with user-provided name, slug, description, and visibility settings",
            "elements": [
                {
                    "type": "input",
                    "purpose": "enter project name"
                },
                {
                    "type": "input",
                    "purpose": "enter project slug/URL"
                },
                {
                    "type": "textarea",
                    "purpose": "enter project description"
                },
                {
                    "type": "radio",
                    "purpose": "set project visibility",
                    "options": [
                        "Private",
                        "Internal",
                        "Public"
                    ]
                },
                {
                    "type": "checkbox",
                    "purpose": "initialize with README"
                },
                {
                    "type": "button",
                    "purpose": "create project"
                }
            ]
        },
        {
            "name": "create_issue",
            "start_url": "http://172.26.116.102:8080/a11yproject/a11yproject.com/issues/new",
            "description": "Create a new issue in a user-specified project with title, description, assignee, milestone, labels, and due date",
            "elements": [
                {
                    "type": "input",
                    "purpose": "enter issue title"
                },
                {
                    "type": "textarea",
                    "purpose": "enter issue description with rich text formatting"
                },
                {
                    "type": "select",
                    "purpose": "assign to user"
                },
                {
                    "type": "select",
                    "purpose": "set milestone"
                },
                {
                    "type": "input",
                    "purpose": "add labels"
                },
                {
                    "type": "date",
                    "purpose": "set due date"
                },
                {
                    "type": "checkbox",
                    "purpose": "make issue confidential"
                },
                {
                    "type": "button",
                    "purpose": "submit issue"
                }
            ]
        },
        {
            "name": "create_snippet",
            "start_url": "http://172.26.116.102:8080/a11yproject/a11yproject.com/snippets/new",
            "description": "Create a code snippet with title, description, visibility settings, and file content",
            "elements": [
                {
                    "type": "input",
                    "purpose": "enter snippet title"
                },
                {
                    "type": "textarea",
                    "purpose": "enter snippet description"
                },
                {
                    "type": "radio",
                    "purpose": "set visibility",
                    "options": [
                        "Private",
                        "Internal",
                        "Public"
                    ]
                },
                {
                    "type": "input",
                    "purpose": "enter file name for syntax highlighting"
                },
                {
                    "type": "textarea",
                    "purpose": "enter code content"
                },
                {
                    "type": "button",
                    "purpose": "create snippet"
                }
            ]
        },
        {
            "name": "create_group",
            "start_url": "http://172.26.116.102:8080/groups/new",
            "description": "Create a new group with name, URL, description, and visibility settings",
            "elements": [
                {
                    "type": "input",
                    "purpose": "enter group name"
                },
                {
                    "type": "input",
                    "purpose": "enter group URL"
                },
                {
                    "type": "textarea",
                    "purpose": "enter group description"
                },
                {
                    "type": "radio",
                    "purpose": "set visibility",
                    "options": [
                        "Private",
                        "Internal",
                        "Public"
                    ]
                },
                {
                    "type": "button",
                    "purpose": "create group"
                }
            ]
        },
        {
            "name": "create_milestone",
            "start_url": "http://172.26.116.102:8080/dashboard/milestones",
            "description": "Create a milestone in a user-specified project with title, description, start date, and due date",
            "elements": [
                {
                    "type": "select",
                    "purpose": "select project for milestone"
                },
                {
                    "type": "input",
                    "purpose": "enter milestone title"
                },
                {
                    "type": "textarea",
                    "purpose": "enter milestone description"
                },
                {
                    "type": "date",
                    "purpose": "set start date"
                },
                {
                    "type": "date",
                    "purpose": "set due date"
                },
                {
                    "type": "button",
                    "purpose": "create milestone"
                }
            ]
        }
    ]
}