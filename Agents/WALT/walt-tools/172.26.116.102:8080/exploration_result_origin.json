{
    "tools": [
        {
            "name": "search_projects",
            "start_url": "http://172.26.116.102:8080/dashboard/projects",
            "description": "Search projects by user-provided search terms with optional filters for project type and sorting",
            "elements": [
                {
                    "type": "input",
                    "purpose": "enter user-provided search terms"
                },
                {
                    "type": "select",
                    "purpose": "filter by project type",
                    "options": [
                        "All",
                        "Personal",
                        "Internal",
                        "Public"
                    ]
                },
                {
                    "type": "select",
                    "purpose": "sort results",
                    "options": [
                        "Last updated",
                        "Name",
                        "Created date",
                        "Stars"
                    ]
                },
                {
                    "type": "button",
                    "purpose": "submit search"
                }
            ]
        },
        {
            "name": "create_project",
            "start_url": "http://172.26.116.102:8080/projects/new",
            "description": "Create a new project with user-provided name, slug, description, and visibility settings",
            "elements": [
                {
                    "type": "input",
                    "purpose": "enter project name"
                },
                {
                    "type": "input",
                    "purpose": "enter project slug/URL"
                },
                {
                    "type": "textarea",
                    "purpose": "enter project description"
                },
                {
                    "type": "radio",
                    "purpose": "set project visibility",
                    "options": [
                        "Private",
                        "Internal",
                        "Public"
                    ]
                },
                {
                    "type": "checkbox",
                    "purpose": "initialize with README"
                },
                {
                    "type": "button",
                    "purpose": "create project"
                }
            ]
        },
        {
            "name": "create_issue",
            "start_url": "http://172.26.116.102:8080/byteblaze/test-project-api-exploration-/-/issues/new",
            "description": "Create a new issue in a user-specified project with title, description, assignee, milestone, labels, and due date",
            "elements": [
                {
                    "type": "input",
                    "purpose": "enter issue title"
                },
                {
                    "type": "textarea",
                    "purpose": "enter issue description with rich text formatting"
                },
                {
                    "type": "select",
                    "purpose": "assign to user"
                },
                {
                    "type": "select",
                    "purpose": "set milestone"
                },
                {
                    "type": "input",
                    "purpose": "add labels"
                },
                {
                    "type": "date",
                    "purpose": "set due date"
                },
                {
                    "type": "checkbox",
                    "purpose": "make issue confidential"
                },
                {
                    "type": "button",
                    "purpose": "submit issue"
                }
            ]
        },
        {
            "name": "comment_on_issue",
            "start_url": "http://172.26.116.102:8080/byteblaze/test-project-api-exploration-/-/issues/1",
            "description": "Add a comment to a user-specified issue with rich text formatting and optional attachments",
            "elements": [
                {
                    "type": "textarea",
                    "purpose": "enter comment text with formatting tools"
                },
                {
                    "type": "button",
                    "purpose": "attach file"
                },
                {
                    "type": "button",
                    "purpose": "submit comment"
                }
            ]
        },
        {
            "name": "create_wiki_page",
            "start_url": "http://172.26.116.102:8080/byteblaze/test-project-api-exploration-/-/wikis/new",
            "description": "Create a new wiki page in a user-specified project with title, format selection, and content",
            "elements": [
                {
                    "type": "input",
                    "purpose": "enter page title"
                },
                {
                    "type": "select",
                    "purpose": "select format",
                    "options": [
                        "Markdown",
                        "RDoc",
                        "AsciiDoc"
                    ]
                },
                {
                    "type": "textarea",
                    "purpose": "enter page content with formatting tools"
                },
                {
                    "type": "input",
                    "purpose": "enter commit message"
                },
                {
                    "type": "button",
                    "purpose": "create page"
                }
            ]
        },
        {
            "name": "create_snippet",
            "start_url": "http://172.26.116.102:8080/byteblaze/test-project-api-exploration-/-/snippets/new",
            "description": "Create a code snippet with title, description, visibility settings, and file content",
            "elements": [
                {
                    "type": "input",
                    "purpose": "enter snippet title"
                },
                {
                    "type": "textarea",
                    "purpose": "enter snippet description"
                },
                {
                    "type": "radio",
                    "purpose": "set visibility",
                    "options": [
                        "Private",
                        "Internal",
                        "Public"
                    ]
                },
                {
                    "type": "input",
                    "purpose": "enter file name for syntax highlighting"
                },
                {
                    "type": "textarea",
                    "purpose": "enter code content"
                },
                {
                    "type": "button",
                    "purpose": "create snippet"
                }
            ]
        },
        {
            "name": "create_group",
            "start_url": "http://172.26.116.102:8080/groups/new",
            "description": "Create a new group with name, URL, description, and visibility settings",
            "elements": [
                {
                    "type": "input",
                    "purpose": "enter group name"
                },
                {
                    "type": "input",
                    "purpose": "enter group URL"
                },
                {
                    "type": "textarea",
                    "purpose": "enter group description"
                },
                {
                    "type": "radio",
                    "purpose": "set visibility",
                    "options": [
                        "Private",
                        "Internal",
                        "Public"
                    ]
                },
                {
                    "type": "button",
                    "purpose": "create group"
                }
            ]
        },
        {
            "name": "create_milestone",
            "start_url": "http://172.26.116.102:8080/dashboard/milestones",
            "description": "Create a milestone in a user-specified project with title, description, start date, and due date",
            "elements": [
                {
                    "type": "select",
                    "purpose": "select project for milestone"
                },
                {
                    "type": "input",
                    "purpose": "enter milestone title"
                },
                {
                    "type": "textarea",
                    "purpose": "enter milestone description"
                },
                {
                    "type": "date",
                    "purpose": "set start date"
                },
                {
                    "type": "date",
                    "purpose": "set due date"
                },
                {
                    "type": "button",
                    "purpose": "create milestone"
                }
            ]
        },
        {
            "name": "search_groups",
            "start_url": "http://172.26.116.102:8080/explore/groups",
            "description": "Search and explore groups with filtering options",
            "elements": [
                {
                    "type": "input",
                    "purpose": "enter search terms for groups"
                },
                {
                    "type": "button",
                    "purpose": "submit search"
                }
            ]
        },
        {
            "name": "track_activity",
            "start_url": "http://172.26.116.102:8080/groups/api-exploration-test-group/-/activity",
            "description": "View and filter activity in a user-specified group by event types",
            "elements": [
                {
                    "type": "select",
                    "purpose": "filter activity by type",
                    "options": [
                        "All",
                        "Push events",
                        "Merge events",
                        "Issue events",
                        "Comments",
                        "Team"
                    ]
                },
                {
                    "type": "button",
                    "purpose": "subscribe to activity feed"
                }
            ]
        }
    ]
}