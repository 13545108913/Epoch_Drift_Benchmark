{
    "tools": [
        {
            "name": "search_orders",
            "start_url": "http://dockerized-magento.local/index.php/admin/sales_order/",
            "description": "Search and filter orders by user-provided criteria (ID, date range, status, amount, customer)",
            "elements": [
                {
                    "type": "input",
                    "purpose": "enter order ID or search term"
                },
                {
                    "type": "select",
                    "purpose": "filter by order status",
                    "options": [
                        "Processing",
                        "Complete",
                        "Cancelled",
                        "On Hold"
                    ]
                },
                {
                    "type": "input",
                    "purpose": "filter by date range (from/to)"
                },
                {
                    "type": "button",
                    "purpose": "search/filter orders"
                }
            ]
        },
        {
            "name": "update_order_status",
            "start_url": "http://dockerized-magento.local/index.php/admin/sales_order/view/order_id/{order_id}/",
            "description": "Update status of a specific order identified by order ID with user-provided status and optional comment",
            "elements": [
                {
                    "type": "textarea",
                    "purpose": "add order comment"
                },
                {
                    "type": "select",
                    "purpose": "select comment visibility",
                    "options": [
                        "Visible on Frontend",
                        "Not Visible to Customer"
                    ]
                },
                {
                    "type": "checkbox",
                    "purpose": "notify customer by email"
                },
                {
                    "type": "button",
                    "purpose": "submit status update"
                }
            ]
        },
        {
            "name": "manage_customers",
            "start_url": "http://dockerized-magento.local/index.php/admin/customer/",
            "description": "Search, filter, and manage customers by user-provided criteria (name, email, group, location)",
            "elements": [
                {
                    "type": "input",
                    "purpose": "search by customer name or email"
                },
                {
                    "type": "select",
                    "purpose": "filter by customer group",
                    "options": [
                        "General",
                        "Wholesale",
                        "Retailer"
                    ]
                },
                {
                    "type": "input",
                    "purpose": "filter by location (ZIP, country, state)"
                },
                {
                    "type": "button",
                    "purpose": "search/filter customers"
                }
            ]
        },
        {
            "name": "create_product",
            "start_url": "http://dockerized-magento.local/index.php/admin/catalog_product/new/",
            "description": "Create new product with user-provided attributes (name, SKU, price, description, categories)",
            "elements": [
                {
                    "type": "select",
                    "purpose": "choose product type",
                    "options": [
                        "Simple Product",
                        "Configurable Product",
                        "Grouped Product",
                        "Virtual Product",
                        "Bundle Product",
                        "Downloadable Product"
                    ]
                },
                {
                    "type": "select",
                    "purpose": "choose attribute set",
                    "options": [
                        "Default",
                        "Books & Music",
                        "Accessories"
                    ]
                },
                {
                    "type": "input",
                    "purpose": "enter product name"
                },
                {
                    "type": "input",
                    "purpose": "enter SKU"
                },
                {
                    "type": "input",
                    "purpose": "enter price"
                },
                {
                    "type": "button",
                    "purpose": "continue to detailed product form"
                }
            ]
        },
        {
            "name": "generate_sales_report",
            "start_url": "http://dockerized-magento.local/index.php/admin/reports_report/sales/",
            "description": "Generate sales report with user-provided parameters (date range, period, store view, report type)",
            "elements": [
                {
                    "type": "input",
                    "purpose": "set report date range (from/to)"
                },
                {
                    "type": "select",
                    "purpose": "select period",
                    "options": [
                        "Day",
                        "Month",
                        "Year"
                    ]
                },
                {
                    "type": "select",
                    "purpose": "select store view",
                    "options": [
                        "All Websites",
                        "Main Website",
                        "Madison Island"
                    ]
                },
                {
                    "type": "select",
                    "purpose": "select report type",
                    "options": [
                        "Order Created Date",
                        "Order Updated Date"
                    ]
                },
                {
                    "type": "button",
                    "purpose": "generate report"
                }
            ]
        },
        {
            "name": "manage_content_pages",
            "start_url": "http://dockerized-magento.local/index.php/admin/cms_page/",
            "description": "Search, filter, and manage CMS content pages by user-provided criteria (title, URL key, status)",
            "elements": [
                {
                    "type": "input",
                    "purpose": "search by page title"
                },
                {
                    "type": "input",
                    "purpose": "search by URL key"
                },
                {
                    "type": "select",
                    "purpose": "filter by page status",
                    "options": [
                        "Enabled",
                        "Disabled"
                    ]
                },
                {
                    "type": "button",
                    "purpose": "search/filter pages"
                }
            ]
        },
        {
            "name": "manage_admin_users",
            "start_url": "http://dockerized-magento.local/index.php/admin/permissions_user/",
            "description": "Manage admin users with user-provided criteria (username, email, status) and perform user administration",
            "elements": [
                {
                    "type": "input",
                    "purpose": "search by username or email"
                },
                {
                    "type": "select",
                    "purpose": "filter by user status",
                    "options": [
                        "Active",
                        "Inactive"
                    ]
                },
                {
                    "type": "button",
                    "purpose": "search/filter admin users"
                }
            ]
        },
        {
            "name": "manage_shipments",
            "start_url": "http://dockerized-magento.local/index.php/admin/sales_order_shipment/",
            "description": "Search and manage shipments by user-provided criteria (shipment #, order #, date, customer)",
            "elements": [
                {
                    "type": "input",
                    "purpose": "search by shipment number"
                },
                {
                    "type": "input",
                    "purpose": "search by order number"
                },
                {
                    "type": "input",
                    "purpose": "filter by date range"
                },
                {
                    "type": "button",
                    "purpose": "search/filter shipments"
                }
            ]
        },
        {
            "name": "manage_invoices",
            "start_url": "http://dockerized-magento.local/index.php/admin/sales_order_invoice/",
            "description": "Search and manage invoices by user-provided criteria (invoice #, order #, date, amount, status)",
            "elements": [
                {
                    "type": "input",
                    "purpose": "search by invoice number"
                },
                {
                    "type": "input",
                    "purpose": "search by order number"
                },
                {
                    "type": "input",
                    "purpose": "filter by date range"
                },
                {
                    "type": "button",
                    "purpose": "search/filter invoices"
                }
            ]
        },
        {
            "name": "manage_roles_permissions",
            "start_url": "http://dockerized-magento.local/index.php/admin/permissions_role/",
            "description": "Manage admin roles and permissions with user-provided criteria (role name, permissions)",
            "elements": [
                {
                    "type": "input",
                    "purpose": "search by role name"
                },
                {
                    "type": "button",
                    "purpose": "search/filter roles"
                }
            ]
        }
    ]
}