{
    "tools": [
        {
            "name": "search_orders",
            "start_url": "http://dockerized-magento.local/index.php/admin/sales_order/",
            "description": "Find orders using user-provided criteria (order number/id, customer, date range, status, total range) and return matching order records.",
            "elements": [
                {
                    "type": "input",
                    "purpose": "enter order identifiers (e.g., order #) and free-text filters"
                },
                {
                    "type": "select",
                    "purpose": "filter by order status / store view (if available)"
                },
                {
                    "type": "button",
                    "purpose": "Search / Apply Filters"
                },
                {
                    "type": "button",
                    "purpose": "Reset Filter"
                },
                {
                    "type": "button",
                    "purpose": "Export results",
                    "options": [
                        "CSV",
                        "Excel XML"
                    ]
                },
                {
                    "type": "select",
                    "purpose": "choose mass action for selected orders",
                    "options": [
                        "Cancel",
                        "Hold",
                        "Unhold",
                        "Print Invoices",
                        "Print Packingslips",
                        "Print Credit Memos",
                        "Print All",
                        "Print Shipping Labels"
                    ]
                },
                {
                    "type": "link",
                    "purpose": "open a specific order record (View)"
                }
            ]
        },
        {
            "name": "update_order_status_add_comment",
            "start_url": "http://dockerized-magento.local/index.php/admin/sales_order/view/order_id/204/",
            "description": "On an order identified by user-provided order_id, add an order history comment and optionally update the order status and notify customer.",
            "elements": [
                {
                    "type": "textarea",
                    "purpose": "enter order comment/message"
                },
                {
                    "type": "select",
                    "purpose": "choose new status for the order (status dropdown)"
                },
                {
                    "type": "checkbox",
                    "purpose": "notify customer by email"
                },
                {
                    "type": "checkbox",
                    "purpose": "make comment visible on storefront/customer"
                },
                {
                    "type": "button",
                    "purpose": "Submit Comment / Update"
                }
            ]
        },
        {
            "name": "issue_credit_memo_refund",
            "start_url": "http://dockerized-magento.local/index.php/admin/sales_order/view/order_id/204/",
            "description": "From an order view, initiate a credit memo to refund user-specified items/amounts for a user-provided order_id.",
            "elements": [
                {
                    "type": "button",
