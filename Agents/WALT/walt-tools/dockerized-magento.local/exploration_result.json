{
    "tools": [
        {
            "name": "view_orders",
            "start_url": "https://dockerized-magento.local/admin/dashboard",
            "description": "Open the Orders grid to list and inspect orders. Supports pagination and basic column sorting.",
            "elements": [
                {
                    "type": "link",
                    "purpose": "Open Sales \u2192 Orders grid",
                    "index": 5
                },
                {
                    "type": "input",
                    "purpose": "Global or grid search (order id, customer, sku)",
                    "index": 2
                },
                {
                    "type": "select",
                    "purpose": "Select date range / period for reports or grid presets",
                    "index": 121,
                    "options": [
                        "Last 24 Hours",
                        "Last 7 Days",
                        "Current Month",
                        "YTD",
                        "2YTD"
                    ]
                },
                {
                    "type": "table",
                    "purpose": "Orders table rows; select a row to open order details"
                }
            ]
        },
        {
            "name": "view_order_details",
            "start_url": "https://dockerized-magento.local/admin/dashboard",
            "description": "Open a single order by order_id to view customer, items, totals, history and available order actions.",
            "elements": [
                {
                    "type": "link",
                    "purpose": "Open Orders grid to locate order",
                    "index": 5
                },
                {
                    "type": "input",
                    "purpose": "Filter by Order ID/Customer/Email/SKU (grid-level)"
                },
                {
                    "type": "row",
                    "purpose": "Select order row to open order detail page"
                },
                {
                    "type": "section",
                    "purpose": "Order detail panels: information, addresses, payment, items, history"
                }
            ]
        },
        {
            "name": "update_order_status",
            "start_url": "https://dockerized-magento.local/admin/dashboard",
            "description": "Locate an order by order_id and update its status to a specified new_status (e.g. Processing, Complete, Canceled, Closed).",
            "elements": [
                {
                    "type": "link",
                    "purpose": "Open Orders grid",
                    "index": 5
                },
                {
                    "type": "row",
                    "purpose": "Select specific order by ID or search"
                },
                {
                    "type": "select",
                    "purpose": "Order status selector on order edit page",
                    "options": [
                        "Pending",
                        "Processing",
                        "Complete",
                        "Closed",
                        "Canceled",
                        "On Hold"
                    ]
                },
                {
                    "type": "button",
                    "purpose": "Save/Update order status"
                }
            ]
        },
        {
            "name": "process_order_actions",
            "start_url": "https://dockerized-magento.local/admin/dashboard",
            "description": "Perform order-level processing actions for a given order_id: create invoice, create shipment, generate credit memo, or add comment to history.",
            "elements": [
                {
                    "type": "link",
                    "purpose": "Open Orders grid",
                    "index": 5
                },
                {
                    "type": "row",
                    "purpose": "Open order details"
                },
                {
                    "type": "button",
                    "purpose": "Invoice (create invoice for items)",
                    "notes": "Invoices link present in menu (index 6) and invoice creation is normally available inside an order"
                },
                {
                    "type": "button",
                    "purpose": "Ship (create shipment)",
                    "notes": "Shipments menu (index 7) exists"
                },
                {
                    "type": "button",
                    "purpose": "Credit Memo / Refund"
                }
            ]
        },
        {
            "name": "cancel_order",
            "start_url": "https://dockerized-magento.local/admin/dashboard",
            "description": "Cancel an order by order_id, recording reason and updating order state to Canceled.",
            "elements": [
                {
                    "type": "link",
                    "purpose": "Open Orders grid",
                    "index": 5
                },
                {
                    "type": "row",
                    "purpose": "Open order details"
                },
                {
                    "type": "button",
                    "purpose": "Cancel Order",
                    "notes": "Action normally on the order detail page"
                },
                {
                    "type": "textarea",
                    "purpose": "Optional cancel comment/reason"
                }
            ]
        },
        {
            "name": "manage_products",
            "start_url": "https://dockerized-magento.local/admin/dashboard",
            "description": "List, create, edit and delete products. Supports filtering, attribute updates and switching store view.",
            "elements": [
                {
                    "type": "link",
                    "purpose": "Open Catalog \u2192 Manage Products",
                    "index": 20
                },
                {
                    "type": "select",
                    "purpose": "Store view selector to scope product changes",
                    "index": 117,
                    "options": [
                        "All Store Views",
                        "English",
                        "French",
                        "German"
                    ]
                },
                {
                    "type": "button",
                    "purpose": "Add New Product"
                },
                {
                    "type": "table",
                    "purpose": "Product grid with editable columns"
                },
                {
                    "type": "action_dropdown",
                    "purpose": "Mass actions on selected products (Delete, Update Attributes, Change Status, Update Inventory)"
                }
            ]
        },
        {
            "name": "bulk_update_product_inventory",
            "start_url": "https://dockerized-magento.local/admin/dashboard",
            "description": "Update inventory quantities and stock status for multiple products using grid mass-action or import/export profiles.",
            "elements": [
                {
                    "type": "link",
                    "purpose": "Open Manage Products grid",
                    "index": 20
                },
                {
                    "type": "action_dropdown",
                    "purpose": "Mass Action: Update Attributes / Change Qty / Change Stock Status"
                },
                {
                    "type": "link",
                    "purpose": "Open System \u2192 Import / Export \u2192 Dataflow profiles",
                    "index": 94
                },
                {
                    "type": "link",
                    "purpose": "Direct Import page",
                    "index": 92
                },
                {
                    "type": "link",
                    "purpose": "Direct Export page",
                    "index": 93
                }
            ]
        },
        {
            "name": "manage_categories",
            "start_url": "https://dockerized-magento.local/admin/dashboard",
            "description": "Create, edit and reorder categories and assign products to categories.",
            "elements": [
                {
                    "type": "link",
                    "purpose": "Open Catalog \u2192 Manage Categories",
                    "index": 21
                },
                {
                    "type": "tree",
                    "purpose": "Category tree for selecting parent/children and drag-reorder"
                },
                {
                    "type": "input",
                    "purpose": "Category name, URL key, description inputs"
                },
                {
                    "type": "select",
                    "purpose": "Is Active, Include in Navigation"
                }
            ]
        },
        {
            "name": "manage_customers",
            "start_url": "https://dockerized-magento.local/admin/dashboard",
            "description": "Search, view, create and edit customer accounts, export customer lists and manage customer groups.",
            "elements": [
                {
                    "type": "link",
                    "purpose": "Open Customers \u2192 Manage Customers",
                    "index": 34
                },
                {
                    "type": "input",
                    "purpose": "Grid filters: name, email, group"
                },
                {
                    "type": "button",
                    "purpose": "Add New Customer"
                },
                {
                    "type": "link",
                    "purpose": "Open Customer Groups",
                    "index": 35
                }
            ]
        },
        {
            "name": "view_customer_analytics",
            "start_url": "https://dockerized-magento.local/admin/dashboard",
