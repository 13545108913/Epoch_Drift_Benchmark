ssuming the first data row is after the header row; use nth(1) for first data row\n    first_data_row = page.get_by_role(\"row\").nth(1)  # Index 0 is header row\n    # Get cells based on column indices: ID is second cell (index 1), Purchase Date is fourth cell (index 3)\n    order_id_cell = first_data_row.get_by_role(\"cell\").nth(1)\n    purchase_date_cell = first_data_row.get_by_role(\"cell\").nth(3)\n    order_id = await order_id_cell.inner_text()\n    purchase_date = await purchase_date_cell.inner_text()\n    \n    return f\"Purchase Date: {purchase_date}, Order ID: {order_id}\"",
