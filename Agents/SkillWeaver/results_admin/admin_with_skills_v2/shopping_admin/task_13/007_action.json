r count\n    if len(order_data) >= 2:\n        second_highest_count = order_data[1][1]\n        # Collect all customers with this count\n        second_most_customers = [customer for customer, count in order_data if count == second_highest_count]\n        result = ', '.join(second_most_customers)\n    else:\n        result = 'Insufficient data to determine second most orders.'\n    \n    return result",
