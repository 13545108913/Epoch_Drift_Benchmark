  "formatted_code": "async def act(page):\n    # Extract grand total amounts from the pending orders in the table\n    # Locate the table\n    table = page.get_by_role('table')\n    if await table.count() == 0:\n        return '0.0'\n\n    # Get the rowgroup containing the data rows (the second rowgroup)\n    rowgroups = table.get_by_role('rowgroup')\n    if await rowgroups.count() < 2:\n        return '0.0'\n    rowgroup = rowgroups.nth(1)  # Index 1 for data rows\n\n    # Get all rows in the data rowgroup\n    rows = rowgroup.get_by_role('row')\n    row_count = await rows.count()\n\n    # If there are no rows, return 0\n    if row_count == 0:\n        return '0.0'\n\n    # Sum the grand totals from all rows (assuming all are pending as per the tree)\n    total_amount = 0.0\n\n    for i in range(row_count):\n        row = rows.nth(i)\n        # The grand total cell is the 8th cell (index 7) based on the tree: 'Grand Total (Purchased)' is the 8th column\n        grand_total_cell = row.get_by_role('cell').nth(7)\n        if await grand_total_cell.count() > 0:\n            cell_text = await grand_total_cell.text_content()\n            # Extract numeric value, remove currency symbols and non-numeric characters\n            import re\n            amount_str = re.sub(r'[^\\d.]', '', cell_text)\n            try:\n                amount = float(amount_str)\n                total_amount += amount\n            except ValueError:\n                # If conversion fails, skip this row\n                continue\n        else:\n            # If grand total cell not found, skip\n            continue\n\n    # Return the total amount as a string\n    return str(total_amount)",
