oesn't support name attributes directly, I'll try to locate by role and label\n    status_filter = page.get_by_role('combobox').filter(has=page.get_by_text('Status'))\n    if await status_filter.count() > 0:\n        await status_filter.select_option('complete')\n        await page.wait_for_load_state('networkidle')\n        await page.wait_for_timeout(2000)\n    else:\n        # Alternative: look for a button or link to filter\n        filter_button = page.get_by_role('button', name='Filters')\n        if await filter_button.count() > 0:\n            await filter_button.click()\n            await page.wait_for_timeout(1000)\n            status_field = page.get_by_role('textbox', name='Status')\n            if await status_field.count() > 0:\n                await status_field.fill('complete')\n                await page.get_by_role('button', name='Apply Filters').click()\n                await page.wait_for_load_state('networkidle')\n                await page.wait_for_timeout(2000)\n    \n    # Step 4: Locate the orders table and get the last 2 rows\n    table = page.get_by_role('table')\n    rows = table.get_by_role('row')\n    row_count = await rows.count()\n    total_amounts = []\n    if row_count >= 2:\n        # Get the last 2 rows (excluding header rows if present)\n        # Assuming the table has a rowgroup for data rows\n        data_rows = table.get_by_role('rowgroup').get_by_role('row')\n        data_row_count = await data_rows.count()\n        if data_row_count >= 2:\n            for i in range(data_row_count - 2, data_row_count):\n                row = data_rows.nth(i)\n                # Extract total amount; assume it's in a cell with role 'cell' and contains currency\n                cells = row.get_by_role('cell')\n                # Find the cell that contains a dollar amount; iterate through cells\n                cell_count = await cells.count()\n                for j in range(cell_count):\n                    cell = cells.nth(j)\n               