r alone. If asked for the name of something, return only the name, and no additional text. Don't add any extra text to `terminate_with_result` beyond your answer. Do not overcomplicate the task; do what it asks for, and nothing more.\n\nDo not interact with the Advanced Reporting tab if you are using Magento Admin.\n",
  "formatted_code": "async def act(page):\n    # Set Period to 'Month' to get monthly data\n    await page.get_by_role('combobox', name='Period').select_option('Month')\n\n    # Set From date to Jan 1, 2022\n    from_date_input = page.get_by_role('textbox', name='From *')\n    await from_date_input.fill('01/01/2022')\n\n    # Set To date to Dec 31, 2022\n    to_date_input = page.get_by_role('textbox', name='To *')\n    await to_date_input.fill('12/31/2022')\n\n    # Ensure Order Status is set to 'Any' (it is selected by default, but select to be sure)\n    await page.get_by_role('combobox', name='Order Status').select_option('Any')\n\n    # Click the 'Show Report' button to generate the report\n    await page.get_by_role('button', name='Show Report').click()\n\n    # Wait for the report to load\n    await page.wait_for_load_state('networkidle')\n    await page.wait_for_timeout(2000)  # Additional wait for table rendering\n\n    # Locate the report table; use get_by_role to find all tables and filter\n    tables = page.get_by_role('table')\n    table_count = await tables.count()\n    monthly_data = []\n    for i in range(table_count):\n        table = tables.nth(i)\n        rows = table.get_by_role('row')\n        row_count = await rows.count()\n        if row_count > 1:  # Assume report table has multiple rows\n            for j in range(row_count):\n                row = rows.nth(j)\n                cells = row.get_by_role('cell')\n                cell_count = await cells.count()\n                if cell_count >= 2:\n                    month_cell = cells.nth(0)\n                    count_cell = cells.nth(1)\n                    month_text = await month_cell.text_content()\n                    count_text = await count_cell.text_content()\n                    month_text = month_text.strip() if month_text else ''\n                    count_text = count_text.strip() if count_text else ''\n                    # Check if this looks like month and count data\n                    if month_text and count_text and count_text.isdigit():\n                        monthly_data.append(f'{month_text}:{count_text}')\n            if monthly_data:  # If we found data, break out of table loop\n                break\n\n    # If no data found, return a message\n    if not monthly_data:\n        return 'No monthly order count data found for 2022.'\n\n    # Format the result: each MM:COUNT on a new line\n    result = '\n'.join(monthly_data)\n    return result",
