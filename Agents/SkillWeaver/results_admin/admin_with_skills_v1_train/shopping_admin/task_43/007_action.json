name_cell = row.get_by_role('cell').nth(2)  # Name is third column (0-indexed 2)\n            email_cell = row.get_by_role('cell').nth(3)  # Email is fourth column (0-indexed 3)\n            customer_name = await name_cell.text_content()\n            customer_email = await email_cell.text_content()\n            found_customer = {'name': customer_name, 'email': customer_email}\n            break\n    \n    if found_customer:\n        # Print the result as required without processing\n        print(found_customer['name'])\n        print(found_customer['email'])\n    else:\n        print(\"No customer found with phone number 2137418080.\")",
