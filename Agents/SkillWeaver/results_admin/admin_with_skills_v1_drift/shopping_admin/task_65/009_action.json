  "formatted_code": "async def act(page):\n    # Step 1: Locate the row for order 299 by its cell content '000000299'\n    order_row = page.get_by_role('row').filter(has=page.get_by_role('cell', name='000000299', exact=True))\n    # Step 2: Find the checkbox in the first cell of this row and click it to select the order\n    checkbox = order_row.get_by_role('checkbox').first\n    await checkbox.wait_for(state='visible')\n    await checkbox.click()\n    # Step 3: Locate the combobox with the 'Cancel' option (it's in a group under the row with 'Select Visible | Unselect Visible | 0 items selected')\n    # First, find the row with 'Select Visible' to get the parent context\n    select_row = page.get_by_role('row').filter(has=page.get_by_role('link', name='Select Visible', exact=True))\n    # Then, within that row, find the combobox in the group\n    combobox = select_row.get_by_role('combobox').first\n    await combobox.wait_for(state='visible')\n    # Select the 'Cancel' option\n    await combobox.select_option('Cancel')\n    # Step 4: Click the 'Submit' button (it's in the same group as the combobox)\n    submit_button = select_row.get_by_role('button', name='Submit', exact=True)\n    await submit_button.wait_for(state='visible')\n    await submit_button.click()\n    # Wait for any network activity to ensure the cancellation is processed\n    await page.wait_for_load_state('networkidle')",
