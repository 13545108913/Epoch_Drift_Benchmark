ount\n    order_counts = [count for _, count in customer_orders]\n    unique_counts = sorted(set(order_counts), reverse=True)\n    if len(unique_counts) > 1:\n        second_most_count = unique_counts[1]\n        customers_with_second_most = [name for name, count in customer_orders if count == second_most_count]\n        result = \", \".join(customers_with_second_most)\n    else:\n        result = \"No second most orders found\"\n    \n    # Store the result in the page context for termination\n    await page.evaluate(f\"window.result = '{result}'\")",
