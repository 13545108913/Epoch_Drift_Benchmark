ssue title is followed by author, then labels if any, then assigned, etc.\n        # We can check the next few links after this one to see if any are label links\n        # Get the index of this link\n        index = all_links.index(link)\n        has_label = False\n        # Check the next links until we hit another issue title or end\n        for i in range(index + 1, len(all_links)):\n            next_link = all_links[i]\n            next_name = await next_link.get_attribute(\"aria-label\") or await next_link.text_content() or \"\"\n            next_url = await next_link.get_attribute(\"href\") or \"\"\n            # If we encounter another issue title link, break\n            if next_name and not any(sub in next_name for sub in [\"Skip to content\", \"Dashboard\", \"Activity\", \"Milestones\", \"Snippets\", \"Instance Statistics\", \"New...\", \"Search\", \"Issues\", \"Merge requests\", \"Todos\", \"help\", \"byteblaze\", \"Select project\", \"Open\", \"Closed\", \"All\", \"Subscribe\", \"Sort direction\", \"assignee\", \"Assigned to\"]) and not any(char in next_name for char in \"[]\") and \"label_name\" not in next_url and \"/issues/\" in next_url:\n                break  # Reached the next issue title\n            # Check if it's a label link\n            if any(char in next_name for char in \"[]\") or \"label_name\" in next_url:\n                has_label = True\n                break\n        if not has_label:\n            issues_without_labels.append(name)\n    \n    # Return the list of issue titles without labels\n    # Since the task is to list them, I'll return the list as a string for terminate_with_result\n    result = \", \".join(issues_without_labels) if issues_without_labels else \"No issues without labels found\"\n    return result\n</code>\n\n<result>\n\"\\n  \\n  \\n  \\n  \\n  \\n  \\n  \\n\\n\\n\\n\\n\\n\\n, \\n\\n, \\n\\n, \\n, \\n, , , \\n2\\n, , \\n0\\n, , \\n7\\n, , , , , \\n0\\n, Clarify usage of flash alert, Lukas Oppermann, , \\n0\\n, 