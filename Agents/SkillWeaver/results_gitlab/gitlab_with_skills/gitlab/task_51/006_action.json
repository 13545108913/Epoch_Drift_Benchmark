mes with brackets or URLs containing 'label_name'\n                if any(char in next_name for char in \"[]\") or \"label_name\" in next_url:\n                    has_label = True\n                    break\n            \n            if not has_label:\n                issues_without_labels.append(name.strip())\n    \n    # Return the list of issue titles without labels\n    result = \", \".join(issues_without_labels) if issues_without_labels else \"No issues without labels found\"\n    return result",
