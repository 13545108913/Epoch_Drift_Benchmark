  "formatted_code": "async def act(page):\n    # Locate the Project name textbox\n    project_name_textbox = page.get_by_role(\"textbox\", name=\"Project name\")\n    current_value = await project_name_textbox.input_value()\n\n    # Check if the current value is already 'Welcome to my site'\n    if current_value != \"Welcome to my site\":\n        await project_name_textbox.fill(\"Welcome to my site\")\n        # Wait a moment for UI to update\n        await page.wait_for_timeout(500)\n    else:\n        print(\"Project name is already 'Welcome to my site'.\")\n\n    # Try to locate the Save changes button using the group to avoid strict mode violation\n    group = page.get_by_role(\"group\").filter(has=page.get_by_role(\"textbox\", name=\"Project name\"))\n    save_button = group.get_by_role(\"button\", name=\"Save changes\")\n\n    # If not found, use the first button with that role and name\n    if await save_button.count() == 0:\n        save_button = page.get_by_role(\"button\", name=\"Save changes\").nth(0)\n\n    # Check if the button is enabled and click it\n    if await save_button.is_enabled():\n        await save_button.click()\n        # Wait for any navigation or confirmation after saving\n        await page.wait_for_load_state(\"networkidle\")\n        print(\"Changes saved successfully.\")\n    else:\n        print(\"Save button is disabled. Trying to trigger validation...\")\n        # Blur the textbox to trigger validation\n        await project_name_textbox.blur()\n        await page.wait_for_timeout(500)\n        if await save_button.is_enabled():\n            await save_button.click()\n            await page.wait_for_load_state(\"networkidle\")\n            print(\"Changes saved after validation trigger.\")\n        else:\n            print(\"Save button remains disabled. No changes made.\")\n    return current_value",
