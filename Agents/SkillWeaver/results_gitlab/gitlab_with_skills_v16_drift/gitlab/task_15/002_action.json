  "formatted_code": "async def act(page):\n    # Extract project names and star counts from the current page\n    projects = []\n\n    # Get all heading level 2 elements (project headings)\n    headings = await page.get_by_role(\"heading\", level=2).all()\n\n    # Get all starrers links by filtering links with href containing '/starrers'\n    starrers_links = []\n    all_links = await page.get_by_role(\"link\").all()\n    for link in all_links:\n        href = await link.get_attribute(\"href\")\n        if href and \"/starrers\" in href:\n            starrers_links.append(link)\n\n    # Pair each heading with its corresponding starrers link by index\n    # Assuming the order matches as per the accessibility tree\n    for i in range(len(headings)):\n        heading = headings[i]\n        # Get the project name from the link inside the heading\n        heading_link = heading.get_by_role(\"link\").first\n        project_name = await heading_link.text_content()\n        project_name = project_name.strip()  # Clean up whitespace\n\n        # Get the star count from the starrers link\n        if i < len(starrers_links):\n            starrers_link = starrers_links[i]\n            star_count_text = await starrers_link.text_content()\n            try:\n                star_count = int(star_count_text)\n            except ValueError:\n                star_count = 0\n        else:\n            star_count = 0\n\n        projects.append({\"name\": project_name, \"stars\": star_count})\n\n    # Find the maximum star count\n    if not projects:\n        return \"No projects found.\"\n    max_stars = max(project[\"stars\"] for project in projects)\n\n    # Get all projects with the maximum star count\n    top_projects = [project[\"name\"] for project in projects if project[\"stars\"] == max_stars]\n\n    # Return the result as a single string, joining multiple names with commas if needed\n    result = \", \".join(top_projects)\n    return result",
