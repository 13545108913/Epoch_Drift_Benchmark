  "formatted_code": "async def act(page):\n    import re\n\n    # List to store full names of repositories with >100 stars\n    result_repos = []\n\n    # Extract project names and URLs from the current accessibility tree\n    # We assume projects starting with 'Byte Blaze /' are ones I contributed to\n    project_data = []\n    # Get all link elements on the page\n    links = page.get_by_role('link')\n    link_count = await links.count()\n    for i in range(link_count):\n        link = links.nth(i)\n        name = await link.text_content()\n        if name and name.startswith('Byte Blaze /'):\n            # Get the URL from the link's href attribute\n            href = await link.get_attribute('href')\n            if href:\n                project_data.append({'name': name.strip(), 'url': href})\n\n    # Remove duplicates based on name\n    unique_projects = []\n    seen_names = set()\n    for project in project_data:\n        if project['name'] not in seen_names:\n            seen_names.add(project['name'])\n            unique_projects.append(project)\n\n    # If no projects found, return empty result\n    if not unique_projects:\n        return 'No repositories found with >100 stars.'\n\n    # For each project, navigate to its page via URL and check star count\n    for project in unique_projects:\n        try:\n            # Navigate directly to the project page using the URL\n            await page.goto(project['url'])\n            await page.wait_for_load_state('networkidle')\n\n            # Try to find the star count element using Accessibility Tree-centric selectors\n            star_count = None\n            # Look for buttons that might contain star count (e.g., with digits)\n            buttons = page.get_by_role('button')\n            button_count = await buttons.count()\n            for j in range(button_count):\n                button = buttons.nth(j)\n                text = await button.text_content()\n                if text and re.search(r'\\d+', text):\n                    # Extract the first number found\n                    numbers = re.findall(r'\\d+', text)\n                    if numbers:\n                        star_count = int(numbers[0])\n                        break\n\n            # If not found in buttons, check for links with star count\n            if star_count is None:\n                links_on_page = page.get_by_role('link')\n                link_count_page = await links_on_page.count()\n                for k in range(link_count_page):\n                    link = links_on_page.nth(k)\n                    text = await link.text_content()\n                    if text and re.search(r'\\d+', text):\n                        numbers = re.findall(r'\\d+', text)\n                        if numbers:\n                            star_count = int(numbers[0])\n                            break\n\n            # Check if star_count is found and >100\n            if star_count and star_count > 100:\n                result_repos.append(project['name'])\n\n            # Navigate back to the activity dashboard\n            await page.goto('/dashboard/activity')\n            await page.wait_for_load_state('networkidle')\n\n        except Exception as e:\n            # If error occurs, log and continue to next project\n            print(f\"Error processing {project['name']}: {e}\")\n            # Try to go back to activity page\n            try:\n                await page.goto('/dashboard/activity')\n                await page.wait_for_load_state('networkidle')\n            except:\n                pass\n\n    # Return the result as a string of full names, comma-separated, or a message\n    if result_repos:\n        return ', '.join(result_repos)\n    else:\n        return 'No repositories found with >100 stars.'",
