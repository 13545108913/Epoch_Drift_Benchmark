{
    "tools": [
        {
            "name": "search_orders",
            "start_url": "http://dockerized-magento.local/index.php/admin/sales_order/",
            "description": "Locate orders using flexible filters (order number, date range, store, billing/shipping name, grand total range, status) and pagination; returns order grid rows and direct 'View' links.",
            "elements": [
                {
                    "type": "input",
                    "purpose": "enter order number or text to search"
                },
                {
                    "type": "date_range",
                    "purpose": "filter by purchase date",
                    "fields": [
                        "from",
                        "to"
                    ],
                    "example_format": "May 30, 2023 11:55:09 PM"
                },
                {
                    "type": "select",
                    "purpose": "filter by store view",
                    "options": [
                        "Main Website / Madison Island / English",
                        "English",
                        "French",
                        "German [deleted]"
                    ]
                },
                {
                    "type": "select",
                    "purpose": "filter by order status",
                    "options": [
                        "Canceled",
                        "Cancelled Ogone",
                        "Closed",
                        "Complete",
                        "Declined Ogone",
                        "Suspected Fraud",
                        "On Hold",
                        "Payment Review",
                        "PayPal Canceled Reversal",
                        "PayPal Reversed",
                        "Pending",
                        "Pending Ogone",
                        "Pending Payment",
                        "Pending PayPal",
                        "Processed Ogone Payment",
                        "Processing",
                        "Processing Ogone Payment",
                        "Waiting Authorization"
                    ]
                },
                {
                    "type": "number_range",
                    "purpose": "filter by grand total (base/purchased)",
                    "fields": [
                        "from",
                        "to"
                    ]
                },
                {
                    "type": "select",
                    "purpose": "set results per page",
                    "options": [
                        20,
                        30,
                        50,
                        100,
                        200
                    ]
                },
                {
                    "type": "button",
                    "purpose": "Search"
                },
                {
                    "type": "button",
                    "purpose": "Reset Filter"
                },
                {
                    "type": "pagination",
                    "purpose": "navigate result pages"
                }
            ]
        },
        {
            "name": "view_order",
            "start_url": "http://dockerized-magento.local/index.php/admin/sales_order/",
            "description": "Open a single order from the orders grid (follow the per-row 'View' link) to inspect order details, transactions and available per-order operations.",
            "elements": [
                {
                    "type": "link",
                    "purpose": "per-order 'View' link, opens order detail (example pattern: /admin/sales_order/view/order_id/{order_id}/)"
                },
                {
                    "type": "panel",
                    "purpose": "order detail sections (items, totals, billing/shipping, history)"
                },
                {
                    "type": "button",
                    "purpose": "actions available in order view (depends on order state; e.g., invoice, credit memo, shipment) - presence inferred from standard Magento admin"
                }
            ]
        },
        {
            "name": "mass_action_orders",
            "start_url": "http://dockerized-magento.local/index.php/admin/sales_order/",
            "description": "Perform mass actions on selected orders in the orders grid (select visible/all then apply action). Useful for cancelling, holding/unholding, and printing documents in bulk.",
            "elements": [
                {
                    "type": "checkbox",
                    "purpose": "select one or more orders (per-row checkboxes and Select Visible/Select All controls)"
                },
                {
                    "type": "select",
                    "purpose": "mass action selector",
                    "options": [
                        "Cancel",
                        "Hold",
                        "Unhold",
                        "Print Invoices",
                        "Print Packingslips",
                        "Print Credit Memos",
                        "Print All",
                        "Print Shipping Labels"
                    ]
                },
                {
                    "type": "button",
                    "purpose": "Submit mass action"
                }
            ]
        },
        {
            "name": "export_orders",
            "start_url": "http://dockerized-magento.local/index.php/admin/sales_order/",
            "description": "Export the current orders grid (filtered set) in a machine-readable format (CSV or Excel XML).",
            "elements": [
                {
                    "type": "select",
                    "purpose": "choose export format",
                    "options": [
                        "CSV",
                        "Excel XML"
                    ]
                },
                {
                    "type": "button",
                    "purpose": "Export"
                }
            ]
        },
        {
            "name": "search_customers",
            "start_url": "http://dockerized-magento.local/index.php/admin/customer/",
            "description": "Find customers using flexible filters (id range, name, email, group, telephone, ZIP, country, state, customer-since date range, website) and pagination; returns customer grid with Edit links.",
            "elements": [
                {
                    "type": "range",
                    "purpose": "ID filter",
                    "fields": [
                        "from",
                        "to"
                    ]
                },
                {
                    "type": "input",
                    "purpose": "name or email search"
                },
                {
                    "type": "select",
                    "purpose": "customer group filter",
                    "options": [
                        "General",
                        "Wholesale",
                        "VIP Member",
                        "Private Sales Member"
                    ]
                },
                {
                    "type": "select",
                    "purpose": "country filter",
                    "options": "(long country list available)"
                },
                {
                    "type": "date_range",
                    "purpose": "Customer Since filter",
                    "fields": [
                        "from",
                        "to"
                    ]
                },
                {
                    "type": "select",
                    "purpose": "website filter",
                    "options": [
                        "Admin",
                        "Main Website"
                    ]
                },
                {
                    "type": "button",
                    "purpose": "Search"
                },
                {
                    "type": "button",
                    "purpose": "Reset Filter"
                }
            ]
        },
        {
            "name": "view_customer",
            "start_url": "http://dockerized-magento.local/index.php/admin/customer/",
            "description": "Open a customer's detail/edit page from the customers grid (per-row 'Edit' link) to view and modify contact info, addresses, group, and newsletter subscription.",
            "elements": [
                {
                    "type": "link",
                    "purpose": "per-customer 'Edit' link (pattern: /admin/customer/edit/id/{customer_id}/)"
                },
                {
                    "type": "form",
                    "purpose": "customer details and addresses panels (edit fields for name, email, group, website)"
                },
                {
                    "type": "button",
                    "purpose": "Save Customer"
                }
            ]
        },
        {
            "name": "mass_action_customers",
            "start_url": "http://dockerized-magento.local/index.php/admin/customer/",
            "description": "Perform mass customer actions (delete, subscribe/unsubscribe newsletter, assign customer group) on selected customers from the grid.",
            "elements": [
                {
                    "type": "checkbox",
                    "purpose": "select customers (per-row checkboxes and Select All/Visible controls)"
                },
                {
                    "type": "select",
                    "purpose": "mass action selector",
                    "options": [
                        {
                            "label": "Delete",
                            "action": "delete"
                        },
                        {
                            "label": "Subscribe to Newsletter",
                            "action": "subscribe_newsletter"
                        },
                        {
                            "label": "Unsubscribe from Newsletter",
                            "action": "unsubscribe_newsletter"
                        },
                        {
                            "label": "Assign a Customer Group",
                            "action": "assign_customer_group"
                        }
                    ]
                },
                {
                    "type": "select",
                    "purpose": "when assigning group - choose group",
                    "options": [
                        "General",
                        "Wholesale",
                        "VIP Member",
                        "Private Sales Member"
                    ]
                },
                {
                    "type": "button",
                    "purpose": "Submit"
                }
            ]
        },
        {
            "name": "search_products",
            "start_url": "http://dockerized-magento.local/index.php/admin/catalog_product/",
            "description": "Find products using filters (ID range, name, type, attribute set, SKU, price range/currency, qty range, visibility, status, website) and pagination; returns product grid with Edit links and checkboxes for bulk operations.",
            "elements": [
                {
                    "type": "range",
                    "purpose": "ID filter",
                    "fields": [
                        "from",
                        "to"
                    ]
                },
                {
                    "type": "input",
                    "purpose": "name or SKU search"
                },
                {
                    "type": "select",
                    "purpose": "product type filter",
                    "options": [
                        "Simple Product",
                        "Grouped Product",
                        "Configurable Product",
                        "Virtual Product",
                        "Bundle Product",
                        "Downloadable Product"
                    ]
                },
                {
                    "type": "select",
                    "purpose": "attribute set filter",
                    "options": [
                        "Default",
                        "Books & Music",
                        "Accessories",
                        "Bed & Bath",
                        "Clothing",
                        "Electronics",
                        "Eyewear",
                        "Home & Decor",
                        "Jewelry",
                        "Shoes",
                        "caps",
                        "My Attribute Set"
                    ]
                },
                {
                    "type": "range",
                    "purpose": "price filter",
                    "fields": [
                        "from",
                        "to"
                    ],
                    "currency_field": "USD"
                },
                {
                    "type": "range",
                    "purpose": "qty filter",
                    "fields": [
                        "from",
                        "to"
                    ]
                },
                {
                    "type": "select",
                    "purpose": "visibility filter",
                    "options": [
                        "Not Visible Individually",
                        "Catalog",
                        "Search",
                        "Catalog, Search"
                    ]
                },
                {
                    "type": "select",
                    "purpose": "status filter",
                    "options": [
                        "Enabled",
                        "Disabled"
                    ]
                },
                {
                    "type": "button",
                    "purpose": "Search"
                },
                {
                    "type": "button",
                    "purpose": "Reset Filter"
                }
            ]
        },
        {
            "name": "edit_product",
            "start_url": "http://dockerized-magento.local/index.php/admin/catalog_product/",
            "description": "Open the product edit page from the product grid (per-row 'Edit') to change product data (name, sku, price, inventory, visibility, status, attributes, websites).",
            "elements": [
                {
                    "type": "link",
                    "purpose": "per-product 'Edit' link (pattern: /admin/catalog_product/edit/id/{product_id}/)"
                },
                {
                    "type": "form",
                    "purpose": "product edit panels (general, prices, inventory, categories, images, urls, design, etc.)"
                },
                {
                    "type": "button",
                    "purpose": "Save Product"
                }
            ]
        },
        {
            "name": "create_product",
            "start_url": "http://dockerized-magento.local/index.php/admin/catalog_product/",
            "description": "Initiate the add-product flow (select product type and attribute set) and create a new product with provided attributes.",
            "elements": [
                {
                    "type": "button",
                    "purpose": "Add Product"
                },
                {
                    "type": "select",
                    "purpose": "product type selector",
                    "options": [
                        "Simple Product",
                        "Grouped Product",
                        "Configurable Product",
                        "Virtual Product",
                        "Bundle Product",
                        "Downloadable Product"
                    ]
                },
                {
                    "type": "select",
                    "purpose": "attribute set selector",
                    "options": [
                        "Default",
                        "Books & Music",
                        "Accessories",
                        "Bed & Bath",
                        "Clothing",
                        "Electronics",
                        "Eyewear",
                        "Home & Decor",
                        "Jewelry",
                        "Shoes",
                        "caps",
                        "My Attribute Set"
                    ]
                },
                {
                    "type": "form",
                    "purpose": "product creation fields (name, sku, price, qty, status, visibility, attributes)"
                },
                {
                    "type": "button",
                    "purpose": "Save Product"
                }
            ]
        },
        {
            "name": "bulk_product_actions",
            "start_url": "http://dockerized-magento.local/index.php/admin/catalog_product/",
            "description": "Perform bulk product operations from the product grid: Delete products, Change status (Enabled/Disabled), Update attributes for multiple selected products.",
            "elements": [
                {
                    "type": "checkbox",
                    "purpose": "select products (per-row checkboxes and Select All/Visible controls)"
                },
                {
                    "type": "select",
                    "purpose": "bulk action selector",
                    "options": [
                        "Delete",
                        "Change status",
                        "Update Attributes"
                    ]
                },
                {
                    "type": "select",
                    "purpose": "if 'Change status' selected - choose status",
                    "options": [
                        "Enabled",
                        "Disabled"
                    ]
                },
                {
                    "type": "button",
                    "purpose": "Submit"
                }
            ]
        },
        {
            "name": "export_products_basic",
            "start_url": "http://dockerized-magento.local/index.php/admin/catalog_product/",
            "description": "(Note: explicit export not visible on products grid) Export capability may be available via other admin tools; this tool begins on the products grid and intends to use available export or dataflow tools if present.",
            "elements": [
                {
                    "type": "note",
                    "purpose": "Products grid did not show a visible CSV/Excel export control in the captured page HTML; use Import/Export or Dataflow profiles for full exports (links visible in navigation)."
                }
            ]
        }
    ]
}