ouple of common ones)\n    # We will try a short list of likely demo credentials. If none work or fields absent, we'll continue.\n    demo_credentials = [(\"admin\", \"admin123\"), (\"admin\", \"password\"), (\"admin\", \"admin\")]\n    logged_in = False\n    for uname, pwd in demo_credentials:\n        try:\n            did_submit = await attempt_login(uname, pwd)\n            # If we submitted a form, give it time to settle and check for table later\n            if did_submit:\n                # allow any redirect to settle\n                await page.wait_for_timeout(1200)\n                logged_in = True\n                break\n        except Exception:\n            continue\n\n    # 3) Whether logged in or not, try to reach the reviews grid pages\n    table_found = False\n    for path in review_paths:\n        try:\n            await page.goto(path)\n            # Wait for an accessible table to appear\n            try:\n                await page.get_by_role(\"table\").first.wait_for(timeout=3000)\n                table_found = True\n                break\n            except Exception:\n                # if role-based table wait failed, fallback to a short DOM wait for a table element\n                try:\n                    await page.wait_for_selector(\"table\", timeout=3000)\n                    table_found = True\n                    break\n                except Exception:\n                    continue\n        except Exception:\n            continue\n\n    if not table_found:\n        # final fallback: try admin root then reviews again once\n        try:\n            await try_navigate_to_admin_root()\n        except Exception:\n            pass\n        for path in review_paths:\n            try:\n                await page.goto(path)\n                try:\n                    await page.get_by_role(\"table\").first.wait_for(timeout=3000)\n                    table_found = True\n                    break\n                except Exception:\n          