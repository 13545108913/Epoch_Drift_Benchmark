  "formatted_code": "async def act(page):\n    import re\n\n    # We considered the knowledge-base helper export_customers_csv_via_grid but it\n    # is specific to Customers export and not relevant for counting reviews, so we\n    # do not call any KB functions.\n\n    # Navigate directly to the Reviews (Customer Reviews) management page using a\n    # relative goto so we continue from the current admin session.\n    await page.goto('/index.php/admin/review_customer/')\n    await page.wait_for_load_state('networkidle')\n\n    # 1) Try to find a summary like \"1-20 of 35\" and extract the total number.\n    summary_locator = page.get_by_text(re.compile(r\"of\\s+\\d+\", re.I))\n    try:\n        if await summary_locator.count() > 0:\n            summary_text = await summary_locator.first().inner_text()\n            m = re.search(r\"of\\s+(\\d+)\", summary_text)\n            if m:\n                total = m.group(1)\n                print(total)\n                return total\n    except Exception:\n        pass\n\n    # 2) Fallback: count visible grid cells or text occurrences matching 'Approved'.\n    try:\n        approved_cells = page.get_by_role('cell', name=re.compile(r'\\bApproved\\b', re.I))\n        cnt = await approved_cells.count()\n        # If we found none as 'cell', try any text occurrences\n        if cnt == 0:\n            approved_texts = page.get_by_text(re.compile(r\"\\bApproved\\b\", re.I))\n            cnt = await approved_texts.count()\n        print(str(cnt))\n        return str(cnt)\n    except Exception:\n        # Final fallback: return empty string to indicate no result found\n        print(\"\")\n        return \"\"",
