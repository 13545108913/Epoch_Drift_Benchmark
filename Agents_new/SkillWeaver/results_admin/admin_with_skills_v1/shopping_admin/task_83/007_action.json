  "python_code": "async def act(page):\n    import asyncio\n\n    # 1) Open the Inventory tab (link shown in the accessibility tree)\n    inv_link_name = (\n        \"The information in this tab has been changed. This tab contains invalid data. Please solve the problem before saving. Inventory\"\n    )\n    inv_link = page.get_by_role(\"link\", name=inv_link_name)\n    if await inv_link.count() > 0:\n        await inv_link.click()\n        # wait briefly for the Inventory tab content to load\n        await asyncio.sleep(0.5)\n\n    # 2) Fill a required Qty field. Try common label variants so the script is robust.\n    qty_locators = [\n        page.get_by_role(\"textbox\", name=\"Qty\"),\n        page.get_by_role(\"textbox\", name=\"Qty *\"),\n        page.get_by_role(\"textbox\", name=\"Quantity\"),\n        page.get_by_role(\"textbox\", name=\"Quantity *\"),\n    ]\n    qty_filled = False\n    for loc in qty_locators:\n        if await loc.count() > 0:\n            await loc.fill(\"100\")\n            qty_filled = True\n            break\n\n    # 3) Set Stock Availability to In Stock (try likely label variants)\n    stock_locators = [\n        page.get_by_role(\"combobox\", name=\"Stock Availability\"),\n        page.get_by_role(\"combobox\", name=\"Stock Availability *\"),\n        page.get_by_role(\"combobox\", name=\"Is in Stock\"),\n    ]\n    stock_set = False\n    for loc in stock_locators:\n        if await loc.count() > 0:\n            # Attempt to select by visible label\n            try:\n                await loc.select_option(\"In Stock\")\n            except Exception:\n                # fallback to selecting by value if label fails -- try common values\n                for opt in (\"1\", \"In Stock\", \"in_stock\", \"in-stock\"):\n                    try:\n                        await loc.select_option(opt)\n                        break\n                    except Exception:\n                        continue\n            stock_set = True\n            break\n\n    # Small pause to ensure changes are processed\n    await asyncio.sleep(0.3)\n\n    # 4) Save the product. This click is expected to navigate away, so it must be the last action.\n    save_button = page.get_by_role(\"button\", name=\"Save\")\n    if await save_button.count() > 0:\n        await save_button.click()",
