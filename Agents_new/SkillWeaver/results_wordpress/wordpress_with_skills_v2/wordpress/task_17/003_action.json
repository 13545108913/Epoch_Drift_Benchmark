t.\n        try:\n            main = page.get_by_role(\"main\")\n            try:\n                await main.wait_for(state=\"visible\", timeout=3000)\n            except Exception:\n                # proceed to locate articles regardless of the wait result\n                pass\n\n            articles = main.get_by_role(\"article\")\n            articles_count = await articles.count()\n            if articles_count == 0:\n                # No articles found in main after the helper run; fall back to manual search below.\n                pass\n            else:\n                first_article = articles.nth(0)\n\n                # Try clicking the first link inside the article (safe, scoped selector).\n                links = first_article.get_by_role(\"link\")\n                links_count = await links.count()\n                if links_count > 0:\n                    await links.nth(0).click()\n                    return\n\n                # Fallback: try heading\n                headings = first_article.get_by_role(\"heading\")\n                headings_count = await headings.count()\n                if headings_count > 0:\n                    await headings.nth(0).click()\n                    return\n\n                # Last resort: click the article container itself\n                await first_article.click()\n                return\n        except Exception:\n            # If anything here fails, fall through to the manual navigation fallback.\n            pass\n\n    # Fallback path: navigate to a relative search URL and click the first result.\n    # Use relative goto as requested.\n    await page.goto(\"/?s=Collector\")\n\n    # Wait briefly for content to render. Prefer role=\"main\" presence.\n    main = page.get_by_role(\"main\")\n    try:\n        await main.wait_for(state=\"visible\", timeout=5000)\n    except Exception:\n        # If waiting by locator fails, allow some network idle wait as a pragmatic fallback.\n        try:\n            await page.w