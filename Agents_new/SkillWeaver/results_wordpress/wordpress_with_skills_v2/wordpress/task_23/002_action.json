 await page.get_by_role(\"main\").wait_for(state=\"visible\", timeout=3000)\n            except Exception:\n                # proceed even if waiting timed out\n                pass\n            clicked = await click_third_to_last_from_main()\n            if clicked:\n                return\n            # If not enough results after helper ran, fall through to fallback navigation\n        except Exception:\n            # fall through to fallback\n            pass\n\n    # 2) Fallback: navigate directly to a search results URL and then click the third-to-last result\n    await page.goto(\"/?s=crypto\")\n\n    try:\n        await page.get_by_role(\"main\").wait_for(state=\"visible\", timeout=5000)\n    except Exception:\n        # fallback to networkidle then a short sleep\n        try:\n            await page.wait_for_load_state(\"networkidle\")\n        except Exception:\n            await asyncio.sleep(1)\n\n    success = await click_third_to_last_from_main()\n    if not success:\n        raise Exception(\"Not enough search results to click the third-to-last item.\")\n",
