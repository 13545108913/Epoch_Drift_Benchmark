ird_article.get_by_role(\"heading\")\n        if await heading_locator.count() > 0:\n            await heading_locator.nth(0).click()\n            return\n        raise Exception(\"Third article result has neither a link nor a heading to click.\")\n\n    # If there are fewer than 3 articles, fall back to headings under main\n    headings = main.get_by_role(\"heading\")\n    heading_count = await headings.count()\n    if heading_count >= 3:\n        third_heading = headings.nth(2)\n        link_in_heading = third_heading.get_by_role(\"link\")\n        if await link_in_heading.count() > 0:\n            await link_in_heading.nth(0).click()\n            return\n        # Otherwise click the heading itself\n        await third_heading.click()\n        return\n\n    # If we cannot find at least 3 results, fail with an informative message\n    raise Exception(f\"Could not find at least 3 search results (articles={article_count}, headings={heading_count}).\")\n",
