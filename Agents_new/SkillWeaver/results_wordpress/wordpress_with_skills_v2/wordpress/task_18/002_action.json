igation to perform the search instead of calling the helper again.\n    \"\"\"\n    # Navigate to the search results using the relative URL\n    await page.goto('/?s=reveals')\n\n    # Prefer waiting for the main region to appear; fall back to networkidle\n    main = page.get_by_role(\"main\")\n    try:\n        await main.wait_for(state=\"visible\", timeout=5000)\n    except Exception:\n        # fallback: wait for network to be idle\n        await page.wait_for_load_state('networkidle')\n\n    # Gather article results\n    articles = main.get_by_role(\"article\")\n    count = await articles.count()\n    if count < 3:\n        raise Exception(f\"Expected at least 3 search results, but found {count}.\")\n\n    third_article = articles.nth(2)\n\n    # Try clicking a link inside the third article first\n    link_locator = third_article.get_by_role(\"link\")\n    if await link_locator.count() > 0:\n        await link_locator.nth(0).click()\n        return\n\n    # Fallback: try clicking a heading inside the article\n    heading_locator = third_article.get_by_role(\"heading\")\n    if await heading_locator.count() > 0:\n        await heading_locator.nth(0).click()\n        return\n\n    # If neither link nor heading is present, raise an error\n    raise Exception(\"Third search result has no clickable link or heading.\")\n\n</code>\n\n<exception>\n'Exception': Expected at least 3 search results, but found 0.\n</exception>\n</previous_actions>\n\nHere is the current website state:\n<webpage_accessibility_tree>\ndocument: \"Search Results for \u201creveals\u201d \u2013 Epoch & Drift Benchmark\" {\n  link: \"Epoch & Drift Benchmark\", url: \"\";\n  link: \"Sample Page\", url: \"/?page_id=2\";\n  main {\n    search {\n      searchbox: \"Search\";\n      button: \"Search\";\n    };\n\n    heading: \"NASA\u2019s Hubble Reveals Largest Found Chaotic Birthplace of Planets\", level: 2 {\n      link: \"NASA\u2019s Hubble Reveals Largest Found Chaotic Birthplace of Planets\", url: