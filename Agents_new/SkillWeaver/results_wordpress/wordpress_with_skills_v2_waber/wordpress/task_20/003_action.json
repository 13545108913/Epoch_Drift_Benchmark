       # If the locator construction fails for some reason, continue to next pattern\n            continue\n\n    # Press Escape as a generic fallback to dismiss overlays\n    try:\n        await page.keyboard.press(\"Escape\")\n        await asyncio.sleep(0.25)\n    except Exception:\n        pass\n\n    # Now call the knowledge-base helper to perform the visible search and scrape results.\n    # The helper will navigate to '/' as its first action, per its contract.\n    results = await create_curated_collection_by_search(page, \"DeepSeek\", max_results=0, resolve_links=True)\n\n    # After the helper runs, attempt to click the bottom article in role=\"main\" if articles are present.\n    try:\n        main = page.get_by_role(\"main\")\n        try:\n            # Wait briefly for main to be present.\n            await main.wait_for(timeout=5000)\n        except Exception:\n            # if it times out, continue and rely on subsequent locators to surface helpful errors\n            pass\n\n        articles = main.get_by_role(\"article\")\n        try:\n            article_count = await articles.count()\n        except Exception:\n            article_count = 0\n\n        if article_count == 0:\n            # Nothing to click; return the helper's raw results as required.\n            return results\n\n        last_idx = article_count - 1\n        last_article = articles.nth(last_idx)\n\n        # Prefer clicking a link inside the article.\n        links = last_article.get_by_role(\"link\")\n        try:\n            link_count = await links.count()\n        except Exception:\n            link_count = 0\n\n        if link_count > 0:\n            # Click the first link inside the bottom article. This may navigate away; do it as the last interaction.\n            await links.nth(0).click()\n            return results\n\n        # If no link is present, try clicking a heading inside the article.\n        headings = last_article.get_by_role(\"heading\")\n        try:\n  