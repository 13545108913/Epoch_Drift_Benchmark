_count}\")\n\n    # 4) Select the third article (index 2).\n    third_article = articles.nth(2)\n\n    # 5) Prefer the heading->link path to target the title link precisely. If that fails,\n    #    fall back to the first link inside the article.\n    target_link = None\n\n    # Try heading -> link\n    headings = third_article.get_by_role(\"heading\")\n    if await headings.count() > 0:\n        heading = headings.nth(0)\n        links_in_heading = heading.get_by_role(\"link\")\n        if await links_in_heading.count() > 0:\n            target_link = links_in_heading.nth(0)\n\n    # Fallback: first link inside the article\n    if target_link is None:\n        links_in_article = third_article.get_by_role(\"link\")\n        if await links_in_article.count() == 0:\n            raise Exception(\"No link found inside the third search result article to click.\")\n        target_link = links_in_article.nth(0)\n\n    # 6) Wait for the link to be visible, then click it. This is the final action (likely navigates away).\n    await target_link.wait_for(state=\"visible\", timeout=5000)\n    await target_link.click()\n",
