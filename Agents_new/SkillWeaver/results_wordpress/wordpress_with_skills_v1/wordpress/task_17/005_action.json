  await heading_links.nth(0).click()\n            return\n\n    # Fallback: any heading link inside the article.\n    heading_any = first_article.get_by_role(\"heading\")\n    if await heading_any.count() > 0:\n        heading_first = heading_any.nth(0)\n        heading_links = heading_first.get_by_role(\"link\")\n        if await heading_links.count() > 0:\n            await heading_links.nth(0).click()\n            return\n\n    # Final fallback: click the first link inside the article.\n    article_links = first_article.get_by_role(\"link\")\n    if await article_links.count() > 0:\n        await article_links.nth(0).click()\n        return\n\n    # Nothing clickable found in the first article; done.\n    return\n",
